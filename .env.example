# Both of these are safe to expose to the browser - this is a fully static
# site, so there is no server-only secret to configure. Every table these
# keys can reach is still governed by Postgres Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Used only for SEO metadata (Open Graph tags, sitemap.xml,
# robots.txt). Auth email links use the browser's own origin instead, so
# this does not need to be set for login/signup/password-reset to work.
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
